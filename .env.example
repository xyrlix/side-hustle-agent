# ============ 环境变量配置示例 ============
# 复制此文件为 .env 并填入实际值

# ============ LLM 配置 ============
# LLM 提供商: deepseek / qwen / kimi / minimax / openai / anthropic
LLM_PROVIDER=deepseek

# API Key（必需）
LLM_API_KEY=your_api_key_here

# 模型名称（可选，有默认值）
# LLM_MODEL=deepseek-chat

# ============ 安全配置 ============
# JWT密钥（生产环境必须修改为复杂随机字符串）
JWT_SECRET=change_me_to_a_random_string_at_least_32_chars

# 允许的来源（CORS，用逗号分隔）
ALLOWED_ORIGINS=http://localhost:1420,https://your-domain.com

# 信任的Host（防止Host头攻击）
TRUSTED_HOSTS=*

# ============ 应用配置 ============
# 端口
PORT=8000

# Python输出不缓冲
PYTHONUNBUFFERED=1

# ============ MiniMax 特定（如果使用MiniMax）============
# MINIMAX_GROUP_ID=your_group_id
{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "副业雷达",
  "version": "0.1.0",
  "identifier": "com.sidehustle.app",
  "build": {
    "beforeBuildCommand": "npm run build",
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "副业雷达",
        "width": 900,
        "height": 700,
        "resizable": true,
        "center": true
      }
    ],
    "security": {
      "csp": null
    }
  }
}
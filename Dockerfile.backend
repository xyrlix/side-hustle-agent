# ============ 后端 Dockerfile ============
FROM python:3.11-slim

WORKDIR /app

# 安装依赖
COPY requirements.txt .
RUN pip install --no-cache-dir -r requirements.txt

# 复制代码
COPY side_hustle_agent/ ./side_hustle_agent/
COPY start.py .

# 创建数据目录
RUN mkdir -p /app/data

# 暴露端口
EXPOSE 8000

# 环境变量
ENV PORT=8000
ENV PYTHONUNBUFFERED=1

# 启动命令
CMD ["python", "start.py"]